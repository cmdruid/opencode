{
  "name": "@cmdcode/opencode-auto-permissions",
  "version": "0.1.0-alpha.4",
  "description": "Experimental model-assisted permission review and session controls for OpenCode",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.ts",
    "./server": "./index.ts",
    "./tui": "./tui.js"
  },
  "files": [
    "index.ts",
    "review.ts",
    "settings.ts",
    "connections.ts",
    "contract.ts",
    "tui.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun run build && bun test --timeout 30000 --preload @opentui/solid/preload --only-failures",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit",
    "build": "bun script/build-tui.ts",
    "pack": "bun script/pack.ts",
    "check:package": "bun script/check-package.ts"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.2.5",
    "effect": "^4.1.0",
    "solid-js": ">=1.9.0",
    "@opentui/solid": ">=0.8.1",
    "@opentui/core": ">=0.8.1"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/core": "workspace:*",
    "@opencode/tui": "workspace:*",
    "@opentui/core": "catalog:",
    "@opentui/solid": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "solid-js": "catalog:",
    "@opencode/theme": "workspace:*"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmdruid/opencode.git",
    "directory": "packages/plugins/permission-review"
  },
  "homepage": "https://github.com/cmdruid/opencode/tree/custom/packages/plugins/permission-review",
  "bugs": {
    "url": "https://github.com/cmdruid/opencode/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "permissions",
    "automatic-review"
  ]
}
