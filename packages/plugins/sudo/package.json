{
  "name": "@cmdcode/opencode-safe-sudo",
  "version": "0.1.0",
  "description": "Sudo for OpenCode with native password isolation and a compact terminal UI",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./server": "./index.ts",
    "./tui": "./tui.js",
    "./rpc": "./rpc.ts"
  },
  "scripts": {
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit",
    "test": "bun run build && bun test --timeout 30000",
    "build:native": "bun script/build-native.ts",
    "prepack": "bun run build",
    "build": "bun run build:native && bun script/build-tui.ts"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.2.5 || ^0.0.0-dev",
    "@opentui/core": "^0.8.1",
    "@opentui/solid": "^0.8.1",
    "effect": "4.1.0",
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@opencode/core": "workspace:*",
    "@opencode/theme": "workspace:*",
    "@opencode/tui": "workspace:*",
    "@opencode/util": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@opentui/core": "0.8.1",
    "@opentui/solid": "0.8.1"
  },
  "files": [
    "index.ts",
    "rpc.ts",
    "requests.ts",
    "tui.tsx",
    "prompt.tsx",
    "native.ts",
    "native/bin/linux-x64/opencode-sudo-tty",
    "native/bin/linux-x64/opencode-sudo-tty.sha256",
    "native/helper.c",
    "native/screen.h",
    "native/README.md",
    "README.md",
    "LICENSE",
    "RELEASING.md",
    "tui.js"
  ],
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmdruid/opencode.git",
    "directory": "packages/plugins/sudo"
  },
  "homepage": "https://github.com/cmdruid/opencode/tree/custom/packages/plugins/sudo",
  "bugs": {
    "url": "https://github.com/cmdruid/opencode/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "sudo",
    "terminal"
  ]
}
